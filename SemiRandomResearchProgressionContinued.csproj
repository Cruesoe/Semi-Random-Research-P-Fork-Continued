<Project Sdk="Microsoft.NET.Sdk">
  <!-- Build settings, RimWorld references and the copy into 1.6\Assemblies all come
       from _ModKit via the Directory.Build.props/.targets alongside this file. This
       replaces a CopyToRimWorldMod target that still pointed at an old folder name and
       silently deployed into a stray, empty mod folder. -->
  <PropertyGroup>
    <RootNamespace>SemiRandomResearchProgressionContinued</RootNamespace>
    <AssemblyName>SemiRandomResearchProgressionContinued</AssemblyName>
    <UnityModules>CoreModule;IMGUIModule;InputLegacyModule;TextRenderingModule</UnityModules>
  </PropertyGroup>
</Project>
