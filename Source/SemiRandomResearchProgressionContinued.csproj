<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>SemiRandomResearchProgressionContinued</RootNamespace>
    <AssemblyName>SemiRandomResearchProgressionContinued</AssemblyName>
    <Nullable>disable</Nullable>
    <RimWorldRoot Condition="'$(RimWorldRoot)' == ''">$(RIMWORLD_DIR)</RimWorldRoot>
    <RimWorldRoot Condition="'$(RimWorldRoot)' == ''">C:\Program Files (x86)\Steam\steamapps\common\RimWorld</RimWorldRoot>
    <RimWorldManaged>$(RimWorldRoot)\RimWorldWin64_Data\Managed</RimWorldManaged>
    <HarmonyDll Condition="'$(HarmonyDll)' == ''">$(HARMONY_DLL)</HarmonyDll>
    <HarmonyDll Condition="'$(HarmonyDll)' == ''">C:\Program Files (x86)\Steam\steamapps\workshop\content\294100\2009463077\Current\Assemblies\0Harmony.dll</HarmonyDll>
    <ModAssemblies>$(MSBuildProjectDirectory)\..\1.6\Assemblies</ModAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp" HintPath="$(RimWorldManaged)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(HarmonyDll)" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(RimWorldManaged)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(RimWorldManaged)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(RimWorldManaged)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(RimWorldManaged)\UnityEngine.TextRenderingModule.dll" Private="false" />
  </ItemGroup>

  <Target Name="VerifyRimWorldReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(RimWorldManaged)\Assembly-CSharp.dll')"
           Text="RimWorld assemblies not found at '$(RimWorldManaged)'. Set RIMWORLD_DIR or pass -p:RimWorldRoot=..." />
    <Error Condition="!Exists('$(HarmonyDll)')"
           Text="0Harmony.dll not found at '$(HarmonyDll)'. Set HARMONY_DLL or install the Harmony workshop item." />
  </Target>

  <Target Name="CopyToModAssemblies" AfterTargets="Build">
    <MakeDir Directories="$(ModAssemblies)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModAssemblies)" SkipUnchangedFiles="true" />
    <Delete Files="$(ModAssemblies)\$(TargetName).pdb" Condition="Exists('$(ModAssemblies)\$(TargetName).pdb')" />
    <Message Importance="high" Text="  -&gt; $(ModAssemblies)\$(TargetFileName)" />
  </Target>
</Project>
